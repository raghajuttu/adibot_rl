<!--
  Corrugated cardboard box with a hinged lid. Include it from a scene in the
  parent folder (texture path is relative to that folder):
      <include file="assets/cardboard_box.xml"/>

  TRAINING VERSION: the real airplane box scaled to 70 % (30 % smaller) to solve
  the task first. The real-size model is in assets/cardboard_box_full_size.xml.

  Inside 0.154 m (x, depth) x 0.161 m (y, width, hinge side) x 0.0665 m tall;
  3 mm walls (not scaled), outside 0.160 x 0.167 x 0.0695 m. Rigid. Free to
  slide/tip (freejoint), on the table top (z = 0.72), 40 cm in front of the robot.

  Lid: hinged along the top edge of the BACK wall (far from the robot).
    joint "lid_hinge":  0 rad = closed, positive = opening, max 2.1 rad
    (120 deg, where the real lid stays open).

  Lid flaps (same behaviour as the real box: they don't tuck in by themselves).
    flap_hinge        front tuck flap, 14.9 x 5.95 cm, crease just inside the
                      front wall. 0 = in line with the lid, 1.57 = tucked.
                      Crease spring rests it at ~0.8 rad.
    side_flap_left /  side flaps: trapezoids, 14 cm at the crease, 9.8 cm at the
    side_flap_right   free edge, 5.25 cm tall. 0 = straight down (tucked),
                      crease spring rests them at ~0.35 rad outwards.

  Sites for task code / rewards:
    lid_handle     middle of the lid's free (front) edge
    flap_edge      middle of the front flap's free edge (v3: the handle to pull)
    box_top        centre of the box opening
    box_left_side  just outside the middle of the left (+y) wall (v1/v2 target)
    box_brace      just outside the front-left corner (v3 left-hand brace target)
-->
<mujoco model="cardboard_box">
  <asset>
    <texture name="cardboard" type="2d" file="assets/textures/cardboard.png"/>
    <material name="cardboard" texture="cardboard" texuniform="true" texrepeat="4 4" specular="0.05" shininess="0.05"/>
    <!-- side flap: trapezoid plate, crease along x at z = 0, free edge at z = -0.0525 -->
    <mesh name="side_flap" vertex="-0.07 -0.0015 0       0.07 -0.0015 0       -0.07 0.0015 0       0.07 0.0015 0
                                    -0.049 -0.0015 -0.0525  0.049 -0.0015 -0.0525  -0.049 0.0015 -0.0525  0.049 0.0015 -0.0525"/>
    <material name="cardboard_inside" texture="cardboard" texuniform="true" texrepeat="4 4" rgba="0.85 0.85 0.85 1" specular="0"/>
  </asset>

  <default>
    <default class="cardboard">
      <!-- Thin board, 3 mm. Same density as the real-size box. Crease springs and
           damping scaled by 0.34 (flap weight torque scales with 0.49 mass x 0.7 length),
           so the flaps and lid behave like the real-size box. -->
      <geom type="box" density="150" material="cardboard" contype="3" conaffinity="3"
            friction="0.5 0.005 0.0001" solref="0.004 1"/>
    </default>
  </default>

  <worldbody>
    <body name="box" pos="0.40 0 0.721">
      <freejoint name="box_free"/>
      <!-- bottom -->
      <geom name="box_bottom" class="cardboard" size="0.080 0.0835 0.0015" pos="0 0 0.0015" material="cardboard_inside"/>
      <!-- walls: front (robot side, -x), back (+x), left (+y), right (-y) -->
      <geom name="box_front" class="cardboard" size="0.0015 0.0835 0.03475" pos="-0.0785 0 0.03475"/>
      <geom name="box_back"  class="cardboard" size="0.0015 0.0835 0.03475" pos=" 0.0785 0 0.03475"/>
      <geom name="box_left"  class="cardboard" size="0.077 0.0015 0.03475" pos="0  0.082 0.03475"/>
      <geom name="box_right" class="cardboard" size="0.077 0.0015 0.03475" pos="0 -0.082 0.03475"/>
      <site name="box_top" pos="0 0 0.0715" size="0.006" rgba="0 0.6 1 0.6"/>
      <site name="box_brace" pos="-0.092 0.0955 0.035" size="0.008" rgba="1 0.9 0 0.8"/>
      <site name="box_left_side" pos="0 0.0955 0.035" size="0.008" rgba="0.8 0.2 1 0.8"/>

      <!-- lid: frame sits on the hinge line (top of back wall) -->
      <body name="lid" pos="0.080 0 0.071">
        <joint name="lid_hinge" type="hinge" axis="0 1 0" range="0 2.1"
               damping="0.005" frictionloss="0.002" armature="0.0005"/>
        <geom name="lid" class="cardboard" size="0.080 0.0835 0.0015" pos="-0.080 0 0"/>
        <site name="lid_handle" pos="-0.160 0 0" size="0.008" rgba="1 0.3 0 0.8"/>

        <!-- front tuck flap: crease on the lid's underside, just inside the front wall -->
        <body name="flap" pos="-0.1553 0 0">
          <joint name="flap_hinge" type="hinge" axis="0 -1 0" range="-0.5 1.7"
                 stiffness="0.0017" springref="0.8" damping="0.0007" armature="0.0002"/>
          <geom name="flap" class="cardboard" size="0.02975 0.0745 0.0015" pos="-0.02975 0 0"/>
          <site name="flap_edge" pos="-0.0595 0 0" size="0.006" rgba="0.2 0.8 0.2 0.8"/>
        </body>

        <!-- side flaps: creases on the lid's underside, just inside the side walls -->
        <body name="side_flap_left" pos="-0.080 0.078 0">
          <joint name="side_flap_left" type="hinge" axis="1 0 0" range="-0.3 1.6"
                 stiffness="0.0034" springref="0.35" damping="0.0007" armature="0.0002"/>
          <geom name="side_flap_left" class="cardboard" type="mesh" mesh="side_flap"/>
        </body>
        <body name="side_flap_right" pos="-0.080 -0.078 0">
          <joint name="side_flap_right" type="hinge" axis="-1 0 0" range="-0.3 1.6"
                 stiffness="0.0034" springref="0.35" damping="0.0007" armature="0.0002"/>
          <geom name="side_flap_right" class="cardboard" type="mesh" mesh="side_flap"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
