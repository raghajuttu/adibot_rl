<!--
  Corrugated cardboard box with a hinged lid (pizza-box style). Include it from
  a scene in the parent folder (texture path is relative to that folder):
      <include file="assets/cardboard_box_v5.xml"/>

  The REAL box used on the robot: inside 16 x 16 x 4 cm.
  3 mm walls, outside 0.166 x 0.166 x 0.043 m. Rigid. Free to slide/tip
  (freejoint), on the table top (z = 0.72), 32 cm in front of the robot (close enough
  for a top-down pinch of the open front flap).
  Other models: cardboard_box_full_size.xml (airplane box 22 x 23 x 9.5 cm),
  cardboard_box_70pct.xml (that box at 70 %).

  Lid: hinged along the top edge of the BACK wall (far from the robot).
    joint "lid_hinge":  0 rad = closed, positive = opening, max 2.1 rad
    (120 deg, where the real lid stays open). The crease holds the lid wherever
    it is let go from 36 deg up; below that it falls shut by itself.

  Lid flaps (v5): bent extensions of the lid, as on the real folded box: each one starts at
  the lid's outer edge (the lid is the full 16.6 x 16.6 cm top). Three straight-edged flaps,
  15 x 3.7 cm. Their creases hold them tilted outwards, so when the lid shuts they stay
  outside the walls, untucked (on the real box you would push them straighter and tuck them
  in: not part of closing the lid).
    flap_hinge        front tuck flap, crease at the lid's front edge.
                      0 = in line with the lid, positive = bent down. Rests at ~0.90 rad with the
                      lid open at 120 deg (spring rest 0.8 rad, plus its weight).
    side_flap_left /  side flaps, creases at the lid's side edges.
    side_flap_right   0 = straight down, rest at ~0.37 rad (21 deg) outwards with the lid open at
                      120 deg, ~0.31 rad (18 deg) with it shut.
  All flaps collide with the box.
  (cardboard_box.xml, used by box_env4: flaps glued under the lid 3-5 mm in from its edges,
  side flaps passing through the walls with box contact off, so a shut lid had them
  sticking 8.6 mm out through the side walls.)

  Sites for task code / rewards:
    lid_handle     middle of the lid's free (front) edge
    flap_edge      middle of the front flap's free edge (the handle to pull)
    box_top        centre of the box opening
    box_left_side  just outside the middle of the left (+y) wall
    box_side_stop  left-hand "side stop" point: outside the middle of the left (+y) wall,
                   1.7 cm out, 2.4 cm above the table (below the wall top). With the left TCP
                   here (start orientation turned 20 deg about z) the closed fingers wait 5 mm
                   from the wall. Pinching the flap shoves the box towards +y (4 cm) and turns
                   it, so the box runs into the fingers and stops (measured: 4.0 -> 0.9 cm).
                   (The old stop in front of the front wall was never touched: the box never
                   moves towards the robot.)
-->
<mujoco model="cardboard_box">
  <asset>
    <texture name="cardboard" type="2d" file="assets/textures/cardboard.png"/>
    <material name="cardboard" texture="cardboard" texuniform="true" texrepeat="4 4" specular="0.05" shininess="0.05"/>
    <material name="cardboard_inside" texture="cardboard" texuniform="true" texrepeat="4 4" rgba="0.85 0.85 0.85 1" specular="0"/>
  </asset>

  <default>
    <default class="cardboard">
      <!-- Thin board, 3 mm, same density as the other box models. -->
      <geom type="box" density="150" material="cardboard" contype="3" conaffinity="3"
            friction="0.5 0.005 0.0001" solref="0.004 1"/>
    </default>
  </default>

  <worldbody>
    <body name="box" pos="0.32 0 0.721">
      <freejoint name="box_free"/>
      <!-- bottom -->
      <geom name="box_bottom" class="cardboard" size="0.083 0.083 0.0015" pos="0 0 0.0015" material="cardboard_inside"/>
      <!-- walls: front (robot side, -x), back (+x), left (+y), right (-y) -->
      <geom name="box_front" class="cardboard" size="0.0015 0.083 0.0215" pos="-0.0815 0 0.0215"/>
      <geom name="box_back"  class="cardboard" size="0.0015 0.083 0.0215" pos=" 0.0815 0 0.0215"/>
      <geom name="box_left"  class="cardboard" size="0.080 0.0015 0.0215" pos="0  0.0815 0.0215"/>
      <geom name="box_right" class="cardboard" size="0.080 0.0015 0.0215" pos="0 -0.0815 0.0215"/>
      <site name="box_top" pos="0 0 0.045" size="0.006" rgba="0 0.6 1 0.6"/>
      <site name="box_side_stop" pos="0 0.100 0.024" size="0.008" rgba="1 0.9 0 0.8"/>
      <site name="box_left_side" pos="0 0.095 0.0215" size="0.008" rgba="0.8 0.2 1 0.8"/>

      <!-- lid: frame sits on the hinge line (top of back wall) -->
      <body name="lid" pos="0.083 0 0.0445">
        <!-- frictionloss = the crease holding the lid: the lid stays put from 36 deg up and
             falls shut by itself below that, like the real box (measured, robot not touching;
             0.0163 here, 0.016 in cardboard_box.xml: the flaps at the edges weigh a bit more).
             solreffriction/solimpfriction make that friction stiff: with MuJoCo's default
             (soft) friction the lid crept shut from 40-45 deg within 10 s. Now it creeps
             about 1 deg in 10 s. A shut lid lies flat on the walls (0 deg), flaps outside.
             The lid never collides with its own box (MuJoCo skips parent-child contacts), so
             the 0 deg stop is the joint limit. solreflimit 0.01 (default 0.02): a press on the
             shut lid's front edge sinks it 2.1 deg at 10 N, 3.5 deg at 20 N (was 4.0 / 5.3).
             Stiffer (0.006, 0.004) made the box jump and tip at 20 N; at 30 N it tips with any
             setting, also with explicit lid-wall contacts: MuJoCo scales contact stiffness with
             the (tiny, 20-25 g) body masses, so the box sinks into the table (measured).
             armature (rotor inertia, which cardboard doesn't have) is kept small, below the
             lid's own 2.5e-4 (was 5e-4 lid / 2e-4 flaps, copied from older box files: the flaps
             then moved like bodies 175x heavier). -->
        <joint name="lid_hinge" type="hinge" axis="0 1 0" range="0 2.1"
               damping="0.005" frictionloss="0.0163" armature="0.0001"
               solreffriction="0.004 1" solimpfriction="0.99 0.999 0.001" solreflimit="0.01 1"/>
        <geom name="lid" class="cardboard" size="0.083 0.083 0.0015" pos="-0.083 0 0"/>
        <site name="lid_handle" pos="-0.166 0 0" size="0.008" rgba="1 0.3 0 0.8"/>

        <!-- Flaps are bent extensions of the lid: each one starts at the lid's outer edge
             (crease 2 mm outside it, so bent 90 deg the flap's inner face is 0.5 mm outside the
             lid edge / wall face and the boards form a clean corner). Each flap board runs from
             the lid's top face down, 3.7 cm below the lid. Closing the lid leaves them outside
             the walls, untucked (tucking them is a separate job). -->
        <!-- front tuck flap: crease at the lid's front edge -->
        <body name="flap" pos="-0.168 0 0">
          <joint name="flap_hinge" type="hinge" axis="0 -1 0" range="-0.5 1.7"
                 stiffness="0.0017" springref="0.8" damping="0.0007" armature="0.00002"/>
          <geom name="flap" class="cardboard" size="0.01925 0.075 0.0015" pos="-0.01775 0 0"/>
          <site name="flap_edge" pos="-0.037 0 0" size="0.006" rgba="0.2 0.8 0.2 0.8"/>
        </body>

        <!-- side flaps: creases at the lid's side edges, resting ~18 deg outwards -->
        <body name="side_flap_left" pos="-0.083 0.085 0">
          <joint name="side_flap_left" type="hinge" axis="1 0 0" range="-0.3 1.6"
                 stiffness="0.0034" springref="0.35" damping="0.0007" armature="0.00002"/>
          <geom name="side_flap_left" class="cardboard" size="0.075 0.0015 0.01925" pos="0 0 -0.01775"/>
        </body>
        <body name="side_flap_right" pos="-0.083 -0.085 0">
          <joint name="side_flap_right" type="hinge" axis="-1 0 0" range="-0.3 1.6"
                 stiffness="0.0034" springref="0.35" damping="0.0007" armature="0.00002"/>
          <geom name="side_flap_right" class="cardboard" size="0.075 0.0015 0.01925" pos="0 0 -0.01775"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Flaps vs the box walls: contact ON. The flaps hang outside the walls, tilted
       outwards, so a closing lid leaves them outside (pushed in, they hit the walls). -->
</mujoco>
